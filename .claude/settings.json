{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(docker logs:*)",
      "Bash(docker exec procurement-server python:*)",
      "Bash(docker ps:*)",
      "Bash(docker compose ps:*)",
      "Bash(curl -s http://localhost:8080/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(//**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./service_account.json)",
      "Read(./service_account.*.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"if ($env:CLAUDE_TOOL_FILE_PATHS -match 'business_rules|reconciliation_engine|google_service') { Write-Output 'Reminder: a core sheet/rules module changed - run: docker exec procurement-server python -m pytest -q' }\""
          }
        ]
      }
    ]
  }
}
