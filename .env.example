# ==============================================================================
# Procurement Receipt OCR & Automation Hub - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI ENGINE MODE (Options: auto | cloud | ollama)
# - auto: Priority to Cloud LLM (Gemini), automatically fallback to local Ollama if offline/quota
# - cloud: Cloud LLM only
# - ollama: Local Ollama only (100% Offline, GPU accelerated)
# ------------------------------------------------------------------------------
AI_ENGINE_MODE=auto

# ------------------------------------------------------------------------------
# 2. CLOUD AI CONFIGURATION (Google Gemini API)
# Get a free Gemini API Key at: https://aistudio.google.com/app/apikey
# Available models: gemini-3.1-flash-lite | gemini-2.5-flash-lite | gemini-3.5-flash-lite
# ------------------------------------------------------------------------------
OPENAI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# 3. LOCAL OLLAMA CONFIGURATION (Offline Vision AI)
# Run on host: ollama run qwen2.5-vl:7b
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5-vl:7b

# ------------------------------------------------------------------------------
# 4. GOOGLE CLOUD INTEGRATION (Google Drive & Google Sheets)
# Place your GCP Service Account JSON file in the project root as `service_account.json`
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Google Drive: Folder ID containing incoming receipt images (Inbox)
# URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_inbox_folder_id_here

# Google Drive: Optional processed folder ID (files will be moved here after processing)
GOOGLE_DRIVE_PROCESSED_FOLDER_ID=your_google_drive_processed_folder_id_here

# Google Sheets: Spreadsheet ID and Tab names
# URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Bang_Ke_Hoa_Don
GOOGLE_SHEET_LINKS_NAME=Links_Hoa_Don
